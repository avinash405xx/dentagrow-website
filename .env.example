# Required for the DentaGrow landing page.
# Google Apps Script Web App (deploy as "Anyone") that receives leads.
# It appends a row to the lead Google Sheet; the Apps Script then emails the
# team the $1 payment link. This is a public ingest URL, not a secret.
#
# On Wasmer, set this as an app environment variable:
#   wasmer app set avinash405xx/dentagrow-landing VITE_GOOGLE_SHEETS_WEB_APP_URL "https://script.google.com/macros/s/<ID>/exec"
#
# NOTE: there is deliberately no payment URL variable. The $1 payment link is
# emailed manually by the team, so no payment endpoint is bundled client-side.
VITE_GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec
